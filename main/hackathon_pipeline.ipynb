from ast_swarm import run_bob_agent
import sqlite3

conn = sqlite3.connect("users.db")
cursor = conn.cursor()
cursor.execute("SELECT * FROM users")
print(cursor.fetchall())

vulnerable_code = """
SELECT * FROM users WHERE username='admin' AND password='1234'
"""
result = run_bob_agent("ParserAgent", vulnerable_code)
print(result)

vulnerable_code = """
import sqlite3
conn = sqlite3.connect("users.db")
cursor = conn.cursor()
username = input("Enter username: ")
password = input("Enter password: ")
query = f"SELECT * FROM users WHERE username='{username}' AND password='{password}'"
cursor.execute(query)
result = cursor.fetchall()
if result:
    print("✅ Vulnerable login successful!")
else:
    print("❌ Login failed!")
conn.close()
"""
result = run_bob_agent("AuditorAgent", vulnerable_code)
print(result)

exploit_code = "admin' OR '1'='1"
result = run_bob_agent("ExploitAgent", exploit_code)
print(result)

secure_code = """
import sqlite3
conn = sqlite3.connect("users.db")
cursor = conn.cursor()
username = input("Enter username: ")
password = input("Enter password: ")
cursor.execute("SELECT * FROM users WHERE username=? AND password=?", (username, password))
result = cursor.fetchall()
if result:
    print("✅ Secure login successful!")
else:
    print("❌ Secure login failed!")
conn.close()
"""
result = run_bob_agent("RefactorAgent", secure_code)
print(result)

register_code = """
def register_user(username, password):
    conn = sqlite3.connect("users.db")
    cursor = conn.cursor()
    cursor.execute("INSERT INTO users (username, password) VALUES (?, ?)", (username, password))
    conn.commit()
    conn.close()
    print("✅ New user registered!")
"""
result = run_bob_agent("RegisterAgent", register_code)
print(result)

change_code = """
def change_password(username, old_pass, new_pass):
    conn = sqlite3.connect("users.db")
    cursor = conn.cursor()
    cursor.execute("SELECT * FROM users WHERE username=? AND password=?", (username, old_pass))
    result = cursor.fetchall()
    if result:
        cursor.execute("UPDATE users SET password=? WHERE username=?", (new_pass, username))
        conn.commit()
        print("✅ Password changed successfully!")
    else:
        print("❌ Old password incorrect!")
    conn.close()
"""
result = run_bob_agent("PasswordAgent", change_code)
print(result)

delete_code = """
def delete_user(username):
    conn = sqlite3.connect("users.db")
    cursor = conn.cursor()
    cursor.execute("DELETE FROM users WHERE username=?", (username,))
    conn.commit()
    conn.close()
    print("✅ User deleted!")
"""
result = run_bob_agent("DeleteAgent", delete_code)
print(result)

