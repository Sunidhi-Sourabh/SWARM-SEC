# Cell 1 – Load vulnerable code
with open("dev/vulnerable_code/vulnerable_example.py") as f:
    vulnerable_code = f.read()
print(vulnerable_code)

# Cell 2 – Run Refactor Agent
from ast_swarm import run_bob_agent
result = run_bob_agent("RefactorAgent", vulnerable_code)
print(result)

# Cell 3 – Save secure code
secure_code = """
import sqlite3

def secure_login(username, password):
    conn = sqlite3.connect("users.db")
    cursor = conn.cursor()
    cursor.execute("SELECT * FROM users WHERE username=? AND password=?", (username, password))
    result = cursor.fetchall()
    conn.close()
    return bool(result)
"""
with open("refactored_code/secure_example.py", "w") as f:
    f.write(secure_code)
print("✅ Secure code saved to refactored_code/secure_example.py")

